# Supabase Postgres
# Runtime (Transaction pooler — port 6543) — pour l’app / Vercel
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations Prisma (Session pooler — port 5432) — joignable depuis Vercel
# Évite db.<project-ref>.supabase.co:5432 (souvent IPv6-only → erreur P1001 sur Vercel)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:4000"
NEXTAUTH_SECRET="change-me-with-a-long-random-string"
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized redirect URI: http://localhost:4000/api/auth/callback/google
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxx"

# Informations légales (footer, mentions, RGPD)
NEXT_PUBLIC_SITE_NAME="Poke Challenge"
NEXT_PUBLIC_SITE_OWNER_NAME="Prénom Nom"
NEXT_PUBLIC_SITE_CONTACT_EMAIL="contact@example.com"
NEXT_PUBLIC_SITE_HOSTING_PROVIDER="Vercel Inc."
NEXT_PUBLIC_SITE_HOSTING_URL="https://vercel.com"
NEXT_PUBLIC_SITE_DATABASE_PROVIDER="Supabase (PostgreSQL, région AWS eu-west-3)"
